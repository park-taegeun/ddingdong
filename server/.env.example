# 띵동 서버 환경변수 템플릿 (실제 .env 는 .gitignore 대상, 절대 commit 금지)
# 키 목록 = app/config.py 가 읽는 키 전부. 셸 환경 변수가 이 파일보다 이긴다(load_dotenv override 기본값 False).
# ★ 「KEY=」(빈 값)으로 둔 키 = 비워도 미설정과 같은 안전한 동작.
#   「# KEY=…」 주석 줄 = 빈 값이 기본값을 덮어 깨지는 키 → 빈 값으로 두지 말 것 — 지우거나 주석으로.

# === 인증 (카테고리 6.1: Device / Dashboard Bearer Token 분리) ===
# 비우면 auth.py 가 모든 요청을 인증 실패로 처리한다(토큰 미설정 우회 방지).
# ESP32 → 서버 인증 토큰 (firmware/include/secrets.h 와 동일값 사용)
DEVICE_TOKEN=replace-with-device-token

# React 대시보드 → 서버 인증 토큰 (dashboard/.env VITE_DASHBOARD_TOKEN 와 동일값 사용)
DASHBOARD_TOKEN=replace-with-dashboard-token

# === 실추론 모델 (카테고리 6.2 env 게이트) ===
# SavedModel 폴더(run 폴더 아래 inference_savedmodel). 비우면 mock 추론(model_serving 로드 스킵).
DDINGDONG_MODEL_PATH=

# /detect 추론 입력 레벨 override(raw / peak). 미설정 = 모델 계약으로 결정(serving_level.resolve_mode).
# 빈 값 · 그 밖의 값 = 기동 실패 → 빈 값으로 두지 말 것 — 지우거나 주석으로.
# DDINGDONG_SERVING_LEVEL=raw

# === 카카오 나에게 보내기 (카테고리 7) ===
# REST_API_KEY + CLIENT_SECRET = 토큰 갱신에 필수. ACCESS/REFRESH_TOKEN = 최초 1회 부트스트랩 입력
# (이후 SSoT = DB kakao_tokens). 비우면 발송만 건너뛴다(kakao.py KakaoTokenError → 발송 skip, 요청은 계속).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# === STT — Naver CSR (카테고리 7 STT / 30.9) ===
# 둘 다 채워야 실호출(과금). 하나라도 비우면 mock 자막(stt.is_real_mode False).
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=

# === DB (카테고리 6) ===
# 미설정 시 server/ddingdong.db (*.db 는 .gitignore 대상).
# 빈 값 = SQLAlchemy URL 파싱 실패로 기동 실패 → 빈 값으로 두지 말 것 — 지우거나 주석으로.
# DATABASE_URL=sqlite:///ddingdong.db

# === 캡처 사진 public 호스팅 (카테고리 7, image_store.py) ===
# 저장 폴더. 미설정 시 server/instance/captures.
# 빈 값 = 사진 저장 때 빈 경로로 실패 → 빈 값으로 두지 말 것 — 지우거나 주석으로.
# DDINGDONG_CAPTURE_DIR=<사진 폴더 경로>
# 사진 URL 앞부분. 미설정 시 /captures (터널 주소는 tools/demo_up.py 가 서버 자식 환경으로 넣는다, 26.12).
# 빈 값 = URL 이 /<id> 가 되어 /captures 라우트와 어긋난다 → 빈 값으로 두지 말 것 — 지우거나 주석으로.
# DDINGDONG_CAPTURE_URL_BASE=https://<public-host>/captures
