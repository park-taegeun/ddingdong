{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets.h)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/secrets.h)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.py\""
          }
        ]
      }
    ]
  }
}
